# Google Sheets Database Configuration
# Tab 1: Businesses | Tab 2: ReviewPrompts
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Method A (Recommended): Google Cloud API Key with Google Sheets API enabled
GOOGLE_SHEETS_API_KEY=""

# Method B: Google Service Account (for private sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Optional: Direct public read fallback URL if sheet is published as web CSV
# APP_URL: The base URL of the deployed application
APP_URL="https://smart-review.in"

